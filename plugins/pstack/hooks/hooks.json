{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\" claude",
            "powershell": "exit 0",
            "statusMessage": "Loading pstack routing"
          }
        ]
      }
    ]
  }
}
